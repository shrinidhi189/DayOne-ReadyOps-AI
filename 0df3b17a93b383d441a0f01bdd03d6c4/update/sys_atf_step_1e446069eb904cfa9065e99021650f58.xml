(function() {
    var tomorrow = new GlideDateTime();
    tomorrow.addDaysLocalTime(1);
    var planGr = new GlideRecord('x_1919740_dayone_0_onboarding_plan');
    planGr.initialize();
    planGr.setValue('employee_name', 'ATF Delay Forecast');
    planGr.setValue('employee_id', 'ATF-007');
    planGr.setValue('state', 'active');
    planGr.setValue('joining_date', tomorrow.getValue().split(' ')[0]);
    var planId = planGr.insert();

    var taskGr = new GlideRecord('x_1919740_dayone_0_onboarding_task');
    taskGr.initialize();
    taskGr.setValue('plan', planId);
    taskGr.setValue('task_name', 'Long Running Task');
    taskGr.setValue('mandatory', true);
    taskGr.setValue('task_state', 'open');
    taskGr.setValue('est_remaining_days', 10);
    taskGr.setValue('department', 'it');
    taskGr.insert();

    var forecaster = new DayOneDelayForecaster(planId);
    var forecast = forecaster.evaluateForecast();
    if (forecast !== 'delayed') throw new Error('Expected delayed, got ' + forecast);
    gs.info('T-07 PASSED: Delay forecast correct when task exceeds available time');
})();
</value>
