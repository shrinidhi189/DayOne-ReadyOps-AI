(function() {
    var planGr = new GlideRecord('x_1919740_dayone_0_onboarding_plan');
    planGr.initialize();
    planGr.setValue('employee_name', 'ATF Audit Test');
    planGr.setValue('employee_id', 'ATF-010');
    planGr.setValue('state', 'active');
    planGr.setValue('readiness_status', 'on_track');
    var planId = planGr.insert();

    planGr = new GlideRecord('x_1919740_dayone_0_onboarding_plan');
    planGr.get(planId);
    planGr.setValue('readiness_status', 'blocked');
    planGr.update();

    var auditGr = new GlideRecord('x_1919740_dayone_0_readiness_audit');
    auditGr.addQuery('plan', planId);
    auditGr.addQuery('event_type', 'status_changed');
    auditGr.query();

    if (!auditGr.hasNext()) throw new Error('No audit entry found for status change to blocked');
    gs.info('T-10 PASSED: Audit log entry created for blocked status');
})();
