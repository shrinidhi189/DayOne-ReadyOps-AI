        <condition/>
        <description>Automatically calculates due date based on joining date minus estimated remaining days when a task is created.</description>
        <execute_function>false</execute_function>
        <filter_condition/>
        <is_rest>false</is_rest>
        <message/>
        <name>Auto Due Date</name>
        <order>50</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous) {
    if (current.getValue('due_date')) {
        return;
    }

    var planSysId = current.getValue('plan');
    if (!planSysId) {
        return;
    }

    var planGr = new GlideRecord('x_1919740_dayone_0_onboarding_plan');
    if (!planGr.get(planSysId)) {
        return;
    }

    var joiningDate = planGr.getValue('joining_date');
    if (!joiningDate) {
        return;
    }

    var estDays = parseInt(current.getValue('est_remaining_days'), 10) || 0;
    if (estDays <= 0) {
        return;
    }

    var dueDate = new GlideDateTime(joiningDate);
    dueDate.addDaysUTC(-estDays);
    current.setValue('due_date', dueDate.getValue());
})(current, previous);
]]></script>
